# Single origin for SPA, API and Keycloak (first-party cookies, no CORS).
{$SITE_ADDRESS:localhost} {
	encode zstd gzip

	handle /api/* {
		reverse_proxy {$API_UPSTREAM:api:8080}
	}

	handle /auth/* {
		reverse_proxy {$API_UPSTREAM:api:8080}
	}
	handle /realms/* {
		reverse_proxy {$KEYCLOAK_UPSTREAM:keycloak:8080}
	}

	handle /resources/* {
		reverse_proxy {$KEYCLOAK_UPSTREAM:keycloak:8080}
	}

	handle {
		header {
			X-Content-Type-Options nosniff
			Referrer-Policy no-referrer
			X-Frame-Options DENY
			Strict-Transport-Security "max-age=31536000; includeSubDomains"
			Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		}
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
